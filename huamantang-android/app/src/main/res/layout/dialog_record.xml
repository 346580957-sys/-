<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="记录健康指标" android:textAppearance="@style/TextAppearance.Huamantang.Section" />
        <ImageButton android:id="@+id/record_dialog_close" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="关闭" android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="指标类型" android:textAppearance="@style/TextAppearance.Huamantang.Caption" />
    <Spinner
        android:id="@+id/record_type_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:spinnerMode="dialog" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/record_value1_layout"
        style="@style/Widget.Huamantang.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:hint="收缩压（高压）mmHg">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/record_value1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789."
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/record_value2_layout"
        style="@style/Widget.Huamantang.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="舒张压（低压）mmHg">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/record_value2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789."
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Huamantang.InputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="备注（选填）">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/record_note_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：晨起、空腹、运动后"
            android:inputType="text"
            android:maxLength="40"
            android:maxLines="1"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/record_input_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="测量前安静休息 5 分钟，保持手臂与心脏同高。"
        android:textAppearance="@style/TextAppearance.Huamantang.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/record_save"
        style="@style/Widget.Huamantang.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="保存记录" />
</LinearLayout>
