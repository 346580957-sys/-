<resources>
    <style name="Theme.Huamantang" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/jade</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/sage_light</item>
        <item name="colorOnSurfaceVariant">@color/ink</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bone</item>
        <item name="android:statusBarColor">@color/bone</item>
        <item name="android:navigationBarColor">@color/ink_deep</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="TextAppearance.Huamantang.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>

    <style name="TextAppearance.Huamantang.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Huamantang.Section" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Huamantang.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Huamantang.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Huamantang.Nav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.Huamantang.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/jade</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Huamantang.Button.Tonal" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/sage_light</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.Huamantang.InputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/jade</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/jade</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Widget.Huamantang.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinTouchTargetSize">40dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ShapeAppearance.Huamantang.Image" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
